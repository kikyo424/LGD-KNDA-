---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "초고휘도 스마트워치·웨어러블 OLED 기술 동향 대시보드",
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Noto+Sans+KR:wght@400;500;700;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --brand: #a50034;
    --brand-hover: #85002a;
    --brand-soft: #f9edf1;
    --page: #f5f4f5;
    --surface: #ffffff;
    --surface-muted: #f0eef0;
    --text: #29262a;
    --text-secondary: #514c53;
    --text-muted: #68616b;
    --border: #ded9df;
    --border-strong: #b4abb6;
    --on-brand: #ffffff;
    font-family: Inter, "Noto Sans KR", system-ui, sans-serif;
    background: var(--page);
    color: var(--text);
  }
  * { box-sizing: border-box; }
  body { margin: 0; min-width: 320px; background: radial-gradient(circle at 15% 0%, var(--brand-soft) 0, transparent 36rem), var(--page); }
  a { color: inherit; }
  button, input, select { font: inherit; }
  button:focus-visible, a:focus-visible, select:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; }
  button:disabled { cursor: not-allowed; opacity: .55; }
  ::selection { background: var(--brand); color: var(--on-brand); }
</style>

