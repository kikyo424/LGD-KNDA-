---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "초고휘도 스마트워치·웨어러블 OLED 기술 동향 대시보드",
} = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Noto+Sans+KR:wght@400;500;700;900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: Inter, "Noto Sans KR", system-ui, sans-serif;
    background: #060913;
    color: #eef3ff;
  }
  * { box-sizing: border-box; }
  body { margin: 0; min-width: 320px; background: radial-gradient(circle at 15% 0%, #152a4d 0, transparent 36rem), #060913; }
  a { color: inherit; }
  button, input { font: inherit; }
</style>

