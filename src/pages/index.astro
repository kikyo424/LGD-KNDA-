---
import Layout from "../layouts/Layout.astro";
import items from "../data/items.json";
import quality from "../data/collection_quality.json";
import lastManual from "../data/last_manual_collection.json";

type Item = {
  id: string;
  source_type: string;
  source: string;
  region: "domestic" | "international";
  title: string;
  published_at: string;
  url: string;
  summary: string;
  technologies: string[];
  company?: string[];
  keywords?: string[];
  keyword_scores?: Record<string, number | undefined>;
  custom_keyword?: string;
  metrics?: { name: string; value: number; unit: string; context: string }[];
};

const documents = (items as Item[])
  .filter((item) => !/^\d{4}/.test(item.published_at) || Number(item.published_at.slice(0, 4)) >= 2023)
  .sort((a, b) => b.published_at.localeCompare(a.published_at));
const documentYears = [...new Set(documents.map((item) => item.published_at.slice(0, 4)).filter((year) => /^\d{4}$/.test(year)))].sort((a, b) => b.localeCompare(a));
const documentYearCounts = documents.reduce<Record<string, number>>((counts, item) => {
  const year = item.published_at.slice(0, 4);
  if (/^\d{4}$/.test(year)) counts[year] = (counts[year] || 0) + 1;
  return counts;
}, {});
const repository = import.meta.env.GITHUB_REPOSITORY || "kikyo424/LGD-KNDA-";
const workflowUrl = `https://github.com/${repository}/actions/workflows/pages.yml`;
const lastManualDocuments = lastManual.keyword
  ? documents.filter((item) => item.custom_keyword?.toLowerCase() === lastManual.keyword.toLowerCase())
  : [];
const categories = ["초고휘도", "저전력", "발광 구조", "야외 시인성", "제조/공정"];
const categoryPurpose: Record<string, string> = {
  "초고휘도": "고휘도 구현 수준",
  "저전력": "배터리 효율",
  "발광 구조": "발광 효율 및 수명",
  "야외 시인성": "실사용 가독성",
  "제조/공정": "양산 가능성",
};
const domesticCount = documents.filter((item) => item.region === "domestic").length;
const internationalCount = documents.filter((item) => item.region === "international").length;
const technologyCounts = documents.flatMap((item) => item.technologies).reduce<Record<string, number>>((acc, tag) => {
  acc[tag] = (acc[tag] || 0) + 1;
  return acc;
}, {});
const sourceCounts = documents.reduce<Record<string, number>>((acc, item) => {
  acc[item.source] = (acc[item.source] || 0) + 1;
  return acc;
}, {});
const keywordCounts = documents.reduce<Record<string, number>>((acc, item) => {
  const scores = item.keyword_scores || Object.fromEntries((item.keywords || []).map((keyword) => [keyword, 1]));
  Object.entries(scores).forEach(([keyword, score]) => {
    const normalized = keyword.trim();
    if (normalized) acc[normalized] = (acc[normalized] || 0) + (score || 0);
  });
  return acc;
}, {});
const topKeywords = Object.entries(keywordCounts).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, 15);
const maxKeywordCount = topKeywords[0]?.[1] || 1;
const currentYear = new Date().getFullYear();
const trendStartYear = Math.max(2023, currentYear - 7);
const trendYears = Array.from({ length: currentYear - trendStartYear + 1 }, (_, index) => String(trendStartYear + index));
const trendKeywords = topKeywords.slice(0, 12).map(([keyword]) => keyword);
const keywordTrendRows = trendKeywords.map((keyword) => ({
  keyword,
  years: trendYears.map((year) => ({
    year,
    count: documents.filter((item) => item.published_at.startsWith(year) && item.keywords?.some((itemKeyword) => itemKeyword.toLowerCase() === keyword.toLowerCase())).length,
  })),
}));
const keywordYearlyMax = Math.max(1, ...keywordTrendRows.flatMap((row) => row.years.map((entry) => entry.count)));
const companyNames = [...new Set(documents.flatMap((item) => item.company || []))];
const companyMatrix = companyNames.map((company) => ({
  company,
  counts: categories.map((category) => documents.filter((item) => item.company?.includes(company) && item.technologies.includes(category)).length),
  total: documents.filter((item) => item.company?.includes(company)).length,
})).sort((a, b) => b.total - a.total).slice(0, 7);
const cooccurrence = categories.flatMap((left, index) => categories.slice(index + 1).map((right) => ({
  pair: `${left} + ${right}`,
  count: documents.filter((item) => item.technologies.includes(left) && item.technologies.includes(right)).length,
}))).sort((a, b) => b.count - a.count).slice(0, 6);
const seenPerformanceMetrics = new Set<string>();
const performanceMetrics = documents
  .flatMap((item) => (item.metrics || []).map((metric) => ({ ...metric, item })))
  .filter((metric) => {
    const key = JSON.stringify([metric.name, metric.value, metric.unit]);
    if (seenPerformanceMetrics.has(key)) return false;
    seenPerformanceMetrics.add(key);
    return true;
  })
  .slice(0, 12);
const decisionAreas = [
  { code: "A", title: "최대 밝기 경쟁", categories: ["초고휘도", "발광 구조"], action: "Tandem·발광 소재·구동 기술 검토" },
  { code: "B", title: "배터리 부담", categories: ["저전력", "초고휘도"], action: "LTPO·발광 효율·구동 최적화" },
  { code: "C", title: "실외 반사", categories: ["야외 시인성", "초고휘도"], action: "저반사·편광·광학 구조 검토" },
  { code: "D", title: "원가·수율", categories: ["제조/공정"], action: "기존 라인·공정 단순화·수율 개선" },
].map((area) => {
  const evidence = documents.filter((item) => area.categories.some((category) => item.technologies.includes(category))).length;
  return { ...area, evidence, score: documents.length ? Math.round((evidence / documents.length) * 100) : 0 };
});
---

<Layout title="OLED Watch Trend Radar">
  <main>
    <header class="hero">
      <div class="eyebrow"><span></span> OPEN TECHNOLOGY INTELLIGENCE</div>
      <h1>야외에서도 보이는<br /><em>OLED의 다음 전략</em></h1>
      <p>초고휘도 스마트워치·웨어러블 OLED의 논문, 특허, 기업 신호를 추적합니다.</p>
      <div class="meta">마지막 빌드 {new Date().toLocaleDateString("ko-KR")} · 공개 API 기반</div>
    </header>

    <section class="stats" aria-label="요약 지표">
      <article><b>{documents.length}</b><span>전체 문서</span></article>
      <article><b>{domesticCount}</b><span>국내 자료</span></article>
      <article><b>{internationalCount}</b><span>해외 자료</span></article>
      <article><b>{Object.keys(technologyCounts).length}</b><span>탐지 기술</span></article>
    </section>



    <section class="taxonomy" aria-label="기술 수집 체계">
      {categories.map((category, index) => (
        <article><span>0{index + 1}</span><h3>{category}</h3><p>{categoryPurpose[category]}</p><strong>{technologyCounts[category] || 0}건</strong></article>
      ))}
    </section>

    <section class="keyword-tools">
      <article class="panel keyword-panel">
        <div class="panel-heading"><div><small>TOP KEYWORDS</small><h2>수집 결과 상위 키워드</h2></div><p class="caution">유사어를 통합하고 제목 2점·요약 1점으로 계산합니다. 버튼을 누르면 관련 문서만 표시합니다.</p></div>
        <div class="keyword-list">
          {topKeywords.map(([keyword, count], index) => (
            <button type="button" data-keyword-filter={keyword.toLowerCase()}>
              <span class="rank">{String(index + 1).padStart(2, "0")}</span>
              <span class="keyword-name">{keyword}</span>
              <i><b style={`width:${Math.max(5, (count / maxKeywordCount) * 100)}%`}></b></i>
              <strong>{count}</strong>
            </button>
          ))}
        </div>
      </article>

      <article class="panel custom-collector">
        <div class="panel-heading"><div><small>MANUAL COLLECTION</small><h2>맞춤 키워드 수집</h2></div></div>
        <form id="collection-form">
          <label>검색 키워드<input id="collect-keyword" required placeholder="예: blue phosphorescent OLED" /></label>
          <div class="date-fields">
            <label>시작일<input id="collect-from" type="date" /></label>
            <label>종료일<input id="collect-to" type="date" /></label>
          </div>
          <label>자료 유형<select id="collect-source"><option value="all">뉴스 + 논문</option><option value="news">뉴스</option><option value="papers">논문</option></select></label>
          <button class="command-button" type="submit">GitHub Actions에서 수집 시작</button>
        </form>
        <div id="collection-result" hidden>
          <p>아래 조건을 GitHub Actions 화면에 입력한 뒤 <b>Run workflow</b>를 누르세요.</p>
          <code id="collection-command"></code>
          <a id="open-workflow" href={workflowUrl} target="_blank" rel="noreferrer">Actions 열기</a>
        </div>
        <p class="collector-help">수집·분석·재배포에는 보통 1~3분이 걸립니다. 완료된 뒤 이 페이지를 새로고침하면 아래 최근 수집 결과에 실제 문서가 표시됩니다.</p>
      </article>
    </section>

    <section id="recent-collection" class="panel recent-collection" aria-label="최근 맞춤 수집 결과" data-collection-at={lastManual.completed_at}>
      <div class="panel-heading"><div><small>LAST CUSTOM COLLECTION</small><h2>최근 맞춤 수집 결과</h2></div></div>
      {lastManual.keyword ? <div class="recent-content">
        <div><span>수집 키워드</span><strong>{lastManual.keyword}</strong></div>
        <div><span>기간</span><strong>{lastManual.date_from || "전체"} ~ {lastManual.date_to || "현재"}</strong></div>
        <div><span>자료 유형</span><strong>{lastManual.source === "all" ? "뉴스 + 논문" : lastManual.source === "news" ? "뉴스" : "논문"}</strong></div>
        <div><span>결과</span><strong>{lastManualDocuments.length}건</strong></div>
        <div><span>완료 시각</span><strong>{lastManual.completed_at ? new Date(lastManual.completed_at).toLocaleString("ko-KR") : "-"}</strong></div>
        <button type="button" id="show-last-collection" data-last-keyword={lastManual.keyword.toLowerCase()}>결과 {lastManualDocuments.length}건 보기</button>
        <button type="button" id="delete-last-collection" data-count={lastManualDocuments.length} disabled={!lastManualDocuments.length}>이 결과 {lastManualDocuments.length}건 삭제</button>
        <div id="delete-instructions" hidden>
          <p>Actions에서 <b>Run workflow</b>를 열고 <b>delete_last_manual</b>에 아래 확인값을 입력해 실행하세요. 배포가 완료되면 문서와 통계에서 삭제됩니다.</p>
          <code>{lastManual.completed_at}</code>
          <p>다른 수집과 겹친 문서도 삭제됩니다. 이후 다시 수집하면 같은 문서가 추가될 수 있습니다.</p>
          <a href={workflowUrl} target="_blank" rel="noreferrer">삭제 실행을 위해 Actions 열기</a>
        </div>
      </div> : <div class="empty">아직 맞춤 수집 이력이 없습니다. 위 조건을 입력해 GitHub Actions를 실행하세요.</div>}
    </section>

    <section class="quality-strip" aria-label="수집 데이터 품질">
      <div><span>저장 문서</span><strong>{quality.saved}</strong></div>
      <div><span>중복 제거</span><strong>{quality.duplicates_removed}</strong></div>
      <div><span>관련성 제외</span><strong>{quality.excluded_irrelevant}</strong></div>
      <div><span>날짜 누락</span><strong>{quality.missing_date}</strong></div>
      <div><span>요약 누락</span><strong>{quality.missing_summary}</strong></div>
      <div><span>수집원 오류</span><strong>{quality.source_errors}</strong></div>
    </section>

    <section class="panel trend-panel">
      <div class="panel-heading"><div><small>KEYWORD TREND BY YEAR</small><h2>키워드별 연도 동향</h2></div><p class="caution">상위 키워드를 선택해 연도별 문서 수를 확인합니다. 문서 건수는 관심도 신호이며 기술 성숙도를 직접 의미하지 않습니다.</p></div>
      <div class="trend-controls">
        <label>키워드<select id="trend-keyword">{trendKeywords.map((keyword) => <option value={keyword.toLowerCase()}>{keyword}</option>)}</select></label>
        <label>연도<select id="trend-year"><option value="all">전체 연도</option>{trendYears.map((year) => <option value={year}>{year}년</option>)}</select></label>
      </div>
      <div class="keyword-trends" aria-label="키워드별 연도 문서 추이">{keywordTrendRows.map((row, rowIndex) => (
        <div class="yearly-chart" data-trend-keyword={row.keyword.toLowerCase()} hidden={rowIndex !== 0}>{row.years.map((entry) => (
          <article data-trend-year={entry.year}><div class="year-title"><strong>{entry.year}</strong><span>{row.keyword}</span></div><div class="year-bar"><i style={`width:${(entry.count / keywordYearlyMax) * 100}%`}></i><span>{entry.count}건</span></div></article>
        ))}</div>
      ))}</div>
    </section>

    <section class="analysis-grid">
      <article class="panel matrix-panel">
        <div class="panel-heading"><div><small>COMPETITIVE MAP</small><h2>기업별 기술 경쟁</h2></div></div>
        {companyMatrix.length ? <div class="table-wrap"><table><thead><tr><th>기업</th>{categories.map((category) => <th>{category}</th>)}</tr></thead><tbody>
          {companyMatrix.map((row) => <tr><th>{row.company}</th>{row.counts.map((count) => <td class:list={{ hot: count > 0 }}>{count}</td>)}</tr>)}
        </tbody></table></div> : <div class="empty">기업명이 확인된 문서가 아직 없습니다.</div>}
      </article>

      <article class="panel relation-panel">
        <div class="panel-heading"><div><small>CO-OCCURRENCE</small><h2>기술 조합 후보</h2></div></div>
        {cooccurrence.map((entry) => <div class="relation-row"><span>{entry.pair}</span><strong>{entry.count}</strong></div>)}
      </article>
    </section>

    <section class="panel performance-panel">
      <div class="panel-heading"><div><small>PERFORMANCE EVIDENCE</small><h2>문헌에 보고된 성능 지표</h2></div><p class="caution">수집 자료에 명시된 성능 수치입니다. 측정 조건은 원문에서 확인해 주세요.</p></div>
      {performanceMetrics.length ? <div class="metric-grid">{performanceMetrics.map(({ item, ...metric }) => (
        <a href={item.url} target="_blank" rel="noreferrer"><span>{metric.name}</span><strong>{metric.value.toLocaleString()} {metric.unit}</strong><p>{metric.context}</p><small>{item.source} · {item.published_at}</small></a>
      ))}</div> : <div class="empty">성능 단위가 명시된 문서를 수집하면 표시됩니다.</div>}
    </section>

    <section class="decision-section">
      <div class="section-heading"><small>CONDITIONAL DECISION</small><h2>주목할 기술 검토 방향</h2><p>수집 자료의 기술 언급 비중을 바탕으로 정리한 검토 방향입니다.</p></div>
      <div class="decision-grid">{decisionAreas.map((area) => (
        <article><div class="decision-top"><span>{area.code}</span><b>{area.score}</b></div><h3>{area.title}</h3><p>{area.action}</p><small>관련 근거 {area.evidence}건</small><div class="score"><i style={`width:${area.score}%`}></i></div></article>
      ))}</div>
    </section>

    <section class="panel documents">
      <div class="panel-heading list-heading">
        <div><small>EVIDENCE FEED</small><h2>최신 기술 문서</h2></div>
        <div class="controls">
          <div class="region-filter" role="group" aria-label="지역 필터">
            <button class="active" type="button" data-region="all">전체 <span>{documents.length}</span></button>
            <button type="button" data-region="domestic">국내 <span>{domesticCount}</span></button>
            <button type="button" data-region="international">해외 <span>{internationalCount}</span></button>
          </div>
          <label class="year-select">연도
            <select id="document-year" aria-label="문서 연도 필터">
              <option value="all">전체 연도</option>
              {documentYears.map((year) => <option value={year}>{year}년 · {documentYearCounts[year]}건</option>)}
            </select>
          </label>
          <input id="document-filter" type="search" placeholder="제목·기술 검색" aria-label="문서 검색" />
        </div>
      </div>
      <p class="document-scroll-help">문서는 한 번에 최대 8개씩 표시됩니다. 목록 안에서 스크롤해 더 확인하세요.</p>
      <div id="document-list" tabindex="0" role="region" aria-label="최신 기술 문서 목록">
        {documents.length ? documents.map((item) => (
          <a class="document" href={item.url} target="_blank" rel="noreferrer" data-custom-keyword={(item.custom_keyword || "").toLowerCase()} data-region={item.region} data-year={item.published_at.slice(0, 4)} data-search={`${item.title} ${item.technologies.join(" ")} ${(item.keywords || []).join(" ")} ${(item.company || []).join(" ")} ${item.custom_keyword || ""}`.toLowerCase()}>
            <div class="doc-meta"><span>{item.source} · {item.region === "domestic" ? "국내" : "해외"}</span><time>{item.published_at || "날짜 미상"}</time></div>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
            <div class="tags">{item.technologies.map((tag) => <span>{tag}</span>)}</div>
          </a>
        )) : <div class="empty large"><strong>아직 수집된 문서가 없습니다.</strong><code>python scripts/collect.py</code>를 실행하세요.</div>}
      </div>
    </section>
    <section class="sources-section">
      <article class="panel sources">
        <div class="panel-heading"><div><small>SOURCES</small><h2>출처 현황</h2></div></div>
        {Object.keys(sourceCounts).length ? <div class="source-list">{Object.entries(sourceCounts).map(([source, count]) => (
          <div class="source-row"><span>{source}</span><strong>{count}</strong></div>
        ))}</div> : <div class="empty">수집기를 실행하면 Crossref·arXiv 자료가 추가됩니다.</div>}
      </article>
    </section>
  </main>

  <script>
    const input = document.querySelector<HTMLInputElement>("#document-filter");
    const yearSelect = document.querySelector<HTMLSelectElement>("#document-year");
    const regionButtons = document.querySelectorAll<HTMLButtonElement>(".region-filter [data-region]");
    let selectedRegion = "all";
    let selectedYear = "all";
    let selectedCollectionKeyword = "";
    const documentList = document.querySelector<HTMLElement>("#document-list");
    const resizeDocumentList = () => {
      if (!documentList) return;
      const visible = [...documentList.querySelectorAll<HTMLElement>(".document")].filter((item) => !item.hidden);
      const eighth = visible[7];
      if (!eighth) {
        documentList.style.maxHeight = "none";
        return;
      }
      const height = eighth.getBoundingClientRect().bottom - documentList.getBoundingClientRect().top + documentList.scrollTop;
      documentList.style.maxHeight = `${height}px`;
    };
    window.addEventListener("resize", resizeDocumentList);
    document.fonts.ready.then(resizeDocumentList);
    resizeDocumentList();
    const applyFilters = () => {
      const query = input?.value.trim().toLowerCase() || "";
      document.querySelectorAll<HTMLElement>(".document").forEach((documentElement) => {
        const matchesText = selectedCollectionKeyword
          ? documentElement.dataset.customKeyword === selectedCollectionKeyword
          : (documentElement.dataset.search || "").includes(query);
        const matchesRegion = selectedRegion === "all" || documentElement.dataset.region === selectedRegion;
        const matchesYear = selectedYear === "all" || documentElement.dataset.year === selectedYear;
        documentElement.hidden = !(matchesText && matchesRegion && matchesYear);
      });
      if (documentList) documentList.scrollTop = 0;
      resizeDocumentList();
    };
    input?.addEventListener("input", () => { selectedCollectionKeyword = ""; applyFilters(); });
    yearSelect?.addEventListener("change", () => {
      selectedYear = yearSelect.value;
      applyFilters();
    });
    const trendKeywordSelect = document.querySelector<HTMLSelectElement>("#trend-keyword");
    const trendYearSelect = document.querySelector<HTMLSelectElement>("#trend-year");
    const applyTrendFilters = () => {
      const keyword = trendKeywordSelect?.value || "";
      const year = trendYearSelect?.value || "all";
      document.querySelectorAll<HTMLElement>("[data-trend-keyword]").forEach((trend) => {
        trend.hidden = trend.dataset.trendKeyword !== keyword;
        trend.querySelectorAll<HTMLElement>("[data-trend-year]").forEach((entry) => {
          entry.hidden = year !== "all" && entry.dataset.trendYear !== year;
        });
      });
    };
    trendKeywordSelect?.addEventListener("change", applyTrendFilters);
    trendYearSelect?.addEventListener("change", applyTrendFilters);
    regionButtons.forEach((button) => button.addEventListener("click", () => {
      selectedRegion = button.dataset.region || "all";
      regionButtons.forEach((candidate) => candidate.classList.toggle("active", candidate === button));
      applyFilters();
    }));

    document.querySelectorAll<HTMLButtonElement>("[data-keyword-filter]").forEach((button) => button.addEventListener("click", () => {
      selectedCollectionKeyword = "";
      if (input) input.value = button.dataset.keywordFilter || "";
      selectedRegion = "all";
      regionButtons.forEach((candidate) => candidate.classList.toggle("active", candidate.dataset.region === "all"));
      applyFilters();
      document.querySelector(".documents")?.scrollIntoView({ behavior: "smooth" });
    }));

    const collectionForm = document.querySelector<HTMLFormElement>("#collection-form");
    const resultBox = document.querySelector<HTMLElement>("#collection-result");
    const commandElement = document.querySelector<HTMLElement>("#collection-command");
    collectionForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      const keyword = document.querySelector<HTMLInputElement>("#collect-keyword")?.value.trim();
      const dateFrom = document.querySelector<HTMLInputElement>("#collect-from")?.value;
      const dateTo = document.querySelector<HTMLInputElement>("#collect-to")?.value;
      const source = document.querySelector<HTMLSelectElement>("#collect-source")?.value || "all";
      if (!keyword) return;
      const sourceLabel = source === "all" ? "뉴스 + 논문" : source === "news" ? "뉴스" : "논문";
      if (commandElement) commandElement.textContent = `키워드: ${keyword} | 기간: ${dateFrom || "전체"} ~ ${dateTo || "현재"} | 자료 유형: ${sourceLabel}`;
      if (resultBox) resultBox.hidden = false;
    });
    document.querySelector<HTMLButtonElement>("#show-last-collection")?.addEventListener("click", (event) => {
      const keyword = (event.currentTarget as HTMLButtonElement | null)?.dataset.lastKeyword || "";
      selectedCollectionKeyword = keyword;
      selectedYear = "all";
      if (yearSelect) yearSelect.value = "all";
      if (input) input.value = keyword;
      selectedRegion = "all";
      regionButtons.forEach((candidate) => candidate.classList.toggle("active", candidate.dataset.region === "all"));
      applyFilters();
      document.querySelector(".documents")?.scrollIntoView({ behavior: "smooth" });
    });
    document.querySelector<HTMLButtonElement>("#delete-last-collection")?.addEventListener("click", (event) => {
      const count = (event.currentTarget as HTMLButtonElement).dataset.count;
      if (!window.confirm(`이 결과 ${count}건을 저장 데이터에서 삭제하시겠습니까? 다른 수집과 겹친 문서도 삭제됩니다. 다음 화면의 Actions 실행 후 적용됩니다.`)) return;
      const instructions = document.querySelector<HTMLElement>("#delete-instructions");
      if (instructions) instructions.hidden = false;
    });
  </script>
</Layout>

