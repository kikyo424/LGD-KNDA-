---
import Layout from "../layouts/Layout.astro";
import { buildKeywordEvidence } from "../lib/keywordEvidence";
import items from "../data/items.json";
import quality from "../data/collection_quality.json";

type Item = {
  id: string;
  source_type: string;
  source: string;
  region: "domestic" | "international";
  title: string;
  published_at: string;
  url: string;
  summary: string;
  technologies: string[];
  company?: string[];
  keywords?: string[];
  keyword_scores?: Record<string, number | undefined>;
  custom_keyword?: string;
  metrics?: { name: string; value: number; unit: string; context: string; target?: string; qualifier?: string; conditions?: string[] }[];
};

const documents = (items as Item[])
  .filter((item) => !/^\d{4}/.test(item.published_at) || Number(item.published_at.slice(0, 4)) >= 2023)
  .sort((a, b) => b.published_at.localeCompare(a.published_at));
const documentYears = [...new Set(documents.map((item) => item.published_at.slice(0, 4)).filter((year) => /^\d{4}$/.test(year)))].sort((a, b) => b.localeCompare(a));
const documentTags = [...new Set(documents.flatMap((item) => item.technologies))].sort((a, b) => a.localeCompare(b, "ko"));
const documentYearCounts = documents.reduce<Record<string, number>>((counts, item) => {
  const year = item.published_at.slice(0, 4);
  if (/^\d{4}$/.test(year)) counts[year] = (counts[year] || 0) + 1;
  return counts;
}, {});
const reportApiUrl = import.meta.env.PUBLIC_REPORT_API_URL || "";
const domesticCount = documents.filter((item) => item.region === "domestic").length;
const internationalCount = documents.filter((item) => item.region === "international").length;
const sourceCounts = documents.reduce<Record<string, number>>((acc, item) => {
  acc[item.source] = (acc[item.source] || 0) + 1;
  return acc;
}, {});
const keywordCounts = documents.reduce<Record<string, number>>((acc, item) => {
  const keywords = new Set((item.keywords || []).map((keyword) => keyword.trim()).filter(Boolean));
  keywords.forEach((keyword) => {
    acc[keyword] = (acc[keyword] || 0) + 1;
  });
  return acc;
}, {});
const topKeywords = Object.entries(keywordCounts).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0])).slice(0, 15);
const keywordEvidence = topKeywords.map(([keyword]) => buildKeywordEvidence(documents, keyword));
const maxKeywordCount = topKeywords[0]?.[1] || 1;
const currentYear = new Date().getFullYear();
const trendStartYear = Math.max(2023, currentYear - 7);
const trendYears = Array.from({ length: currentYear - trendStartYear + 1 }, (_, index) => String(trendStartYear + index));
const trendKeywords = topKeywords.slice(0, 12).map(([keyword]) => keyword);
const keywordTrendRows = trendKeywords.map((keyword) => ({
  keyword,
  years: trendYears.map((year) => ({
    year,
    count: documents.filter((item) => item.published_at.startsWith(year) && item.keywords?.some((itemKeyword) => itemKeyword.toLowerCase() === keyword.toLowerCase())).length,
  })),
}));
const keywordYearlyMax = Math.max(1, ...keywordTrendRows.flatMap((row) => row.years.map((entry) => entry.count)));
const companyNames = [...new Set(documents.flatMap((item) => item.company || []))];
const companyMatrix = companyNames.map((company) => {
  const companyDocuments = documents.filter((item) => item.company?.includes(company));
  const counts = companyDocuments.reduce<Record<string, number>>((acc, item) => {
    new Set(item.keywords || []).forEach((keyword) => { acc[keyword] = (acc[keyword] || 0) + 1; });
    return acc;
  }, {});
  return {
    company,
    total: companyDocuments.length,
    keywords: Object.entries(counts).sort(([left, leftCount], [right, rightCount]) => rightCount - leftCount || left.localeCompare(right, "ko")),
  };
}).sort((a, b) => b.total - a.total).slice(0, 7);
const metricLabels: Record<string, string> = { brightness: "휘도", reflectance: "반사율", power: "소비전력", lifetime: "OLED 수명" };
const seenPerformanceMetrics = new Set<string>();
const performanceMetrics = documents
  .flatMap((item) => (item.metrics || []).map((metric) => ({ ...metric, item })))
  .filter((metric) => {
    if (!metricLabels[metric.name]) return false;
    const key = JSON.stringify([metric.item.id, metric.name, metric.value, metric.unit, metric.context]);
    if (seenPerformanceMetrics.has(key)) return false;
    seenPerformanceMetrics.add(key);
    return true;
  });
const decisionAreas = [
  { code: "A", title: "최대 밝기 경쟁", categories: ["초고휘도", "발광 구조"], action: "Tandem·발광 소재·구동 기술 검토" },
  { code: "B", title: "배터리 부담", categories: ["저전력", "초고휘도"], action: "LTPO·발광 효율·구동 최적화" },
  { code: "C", title: "실외 반사", categories: ["야외 시인성", "초고휘도"], action: "저반사·편광·광학 구조 검토" },
  { code: "D", title: "원가·수율", categories: ["제조/공정"], action: "기존 라인·공정 단순화·수율 개선" },
].map((area) => {
  const evidence = documents.filter((item) => area.categories.some((category) => item.technologies.includes(category))).length;
  return { ...area, evidence, score: documents.length ? Math.round((evidence / documents.length) * 100) : 0 };
});
const buildTime = new Date();
const nextUpdate = new Date(buildTime);
nextUpdate.setUTCHours(0, 10, 0, 0);
if (nextUpdate <= buildTime) nextUpdate.setUTCDate(nextUpdate.getUTCDate() + 1);
const koreanDateTime = new Intl.DateTimeFormat("ko-KR", {
  timeZone: "Asia/Seoul", year: "numeric", month: "2-digit", day: "2-digit",
  hour: "2-digit", minute: "2-digit", hour12: false,
});
---

<Layout title="Navigator MAP" description="야외 시인성과 전력 효율을 높이는 스마트워치 OLED 기술을 분석하고, 글로벌 시장을 위한 상용화 방향을 살펴봅니다.">
  <main>
    <header class="hero">
      <div class="eyebrow"><span></span> OPEN TECHNOLOGY INTELLIGENCE</div>
      <h1>초고휘도 스마트워치 OLED<br /><em>상용화 전략 분석</em></h1>
      <p class="hero-subtitle">직사광선 아래 또렷하게, 작은 배터리로 더 오래</p>
      <p>야외 시인성과 전력 효율을 높이는 스마트워치 OLED 기술을 분석하고, 글로벌 시장을 위한 상용화 방향을 살펴봅니다.</p>
      <div class="meta">
        <span>마지막 빌드 <time datetime={buildTime.toISOString()}>{koreanDateTime.format(buildTime)}</time> (한국 시간)</span>
        <span>다음 자동 업데이트 예정 <time id="next-update" datetime={nextUpdate.toISOString()}>{koreanDateTime.format(nextUpdate)}</time> (한국 시간)</span>
        <span>매일 한국 시간(KST, UTC+9) 오전 9시 10분 자동 수집 시작 · 수집·배포 상황에 따라 반영이 지연될 수 있습니다.</span>
        <span>GitHub Pages 특성상 배포 완료 후에도 캐시 갱신 등으로 변경 사항이 바로 보이지 않을 수 있습니다.</span>
        <span>수집원: Google 뉴스 국내·영문 해외 RSS · Crossref · arXiv · Semantic Scholar · OpenAlex</span>
      </div>
    </header>

    <section class="stats" aria-label="요약 지표">
      <article><b>{documents.length}</b><span>전체 문서</span></article>
      <article><b>{domesticCount}</b><span>국내 자료</span></article>
      <article><b>{internationalCount}</b><span>해외 자료</span></article>
    </section>

    <section class="quality-strip" aria-label="수집 데이터 품질">
      <div><span>저장 문서</span><strong>{quality.saved}</strong></div>
      <div><span>중복 제거</span><strong>{quality.duplicates_removed}</strong></div>
      <div><span>관련성 제외</span><strong>{quality.excluded_irrelevant}</strong></div>
      <div><span>날짜 누락</span><strong>{quality.missing_date}</strong></div>
      <div><span>요약 누락</span><strong>{quality.missing_summary}</strong></div>
      <div><span>수집원 오류</span><strong>{quality.source_errors}</strong></div>
    </section>

    <section class="keyword-tools">
      <article class="panel keyword-panel">
        <div class="panel-heading"><div><small>TOP KEYWORDS</small><h2>수집 결과 상위 키워드</h2></div><p class="caution">키워드가 포함된 자료 수가 많은 순서입니다. 한 자료에서는 같은 키워드를 한 번만 집계합니다. 버튼을 누르면 해당 자료만 표시합니다.</p></div>
        <div class="keyword-list">
          {topKeywords.map(([keyword, count], index) => (
            <button type="button" data-keyword-filter={keyword.toLowerCase()}>
              <span class="rank">{String(index + 1).padStart(2, "0")}</span>
              <span class="keyword-name">{keyword}</span>
              <i><b style={`width:${Math.max(5, (count / maxKeywordCount) * 100)}%`}></b></i>
              <strong>{count}건</strong>
            </button>
          ))}
        </div>
      </article>

      <article class="panel custom-collector">
        <div class="panel-heading"><div><small>MANUAL COLLECTION</small><h2>맞춤 키워드 HTML 보고서</h2></div></div>
        <form id="collection-form" data-report-api={reportApiUrl}>
          <label>검색 키워드<input id="collect-keyword" maxlength="200" required placeholder="예: LG DISPLAY" /></label>
          <div class="date-fields">
            <label>시작일<input id="collect-from" type="date" /></label>
            <label>종료일<input id="collect-to" type="date" /></label>
          </div>
          <label>자료 유형<select id="collect-source"><option value="all">뉴스 + 논문</option><option value="news">뉴스</option><option value="papers">논문</option></select></label>
          <button class="command-button" type="submit">HTML 보고서 만들기</button>
        </form>
        <div id="collection-result" role="status" aria-live="polite" hidden>
          <p id="collection-status"></p>
          <a id="download-report" hidden>HTML 보고서 다운로드</a>
        </div>
        <p class="collector-help">국내·해외 뉴스와 논문을 수집해 HTML 파일로 제공합니다. GitHub 로그인 없이 사용할 수 있으며 사이트 데이터에는 추가하지 않습니다. 첫 요청은 서버 준비로 지연될 수 있습니다. 무료 사용 한도나 서버 상태에 따라 일시적으로 수집이 제한될 수 있습니다. 완료 후 이 화면에서 다운로드하세요. 파일은 최대 1시간 동안 제공되며 서버 재시작 시 사라집니다.</p>
      </article>
    </section>


    <details class="panel trend-panel section-disclosure">
      <summary class="section-summary"><div class="section-title"><small>KEYWORD TREND BY YEAR</small><h2>키워드별 연도 동향</h2></div><span class="section-toggle"><span class="when-closed">보기</span><span class="when-open">접기</span></span></summary>
      <div class="section-content">
      <p class="caution">키워드를 선택해 연도별 문서 수를 비교하세요. 연도 카드를 누르면 해당 문서만 볼 수 있습니다.</p>
      <div class="trend-controls">
        <label>키워드<select id="trend-keyword">{trendKeywords.map((keyword) => <option value={keyword.toLowerCase()}>{keyword}</option>)}</select></label>
        <label>연도<select id="trend-year"><option value="all">전체 연도</option>{trendYears.map((year) => <option value={year}>{year}년</option>)}</select></label>
      </div>
      <div class="keyword-trends" aria-label="키워드별 연도 문서 추이">{keywordTrendRows.map((row, rowIndex) => (
        <div class="yearly-chart" data-trend-keyword={row.keyword.toLowerCase()} hidden={rowIndex !== 0}>{row.years.map((entry) => (
          <button type="button" class="year-card" data-trend-year={entry.year} data-trend-filter={row.keyword.toLowerCase()} aria-label={`${entry.year}년 ${row.keyword} 문서 ${entry.count}건 보기`}>
            <span class="year-title"><strong>{entry.year}년</strong><span>{row.keyword}</span></span>
            <span class="year-count">{entry.count}<small>건</small></span>
            <span class="year-bar" aria-hidden="true"><i style={`width:${(entry.count / keywordYearlyMax) * 100}%`}></i></span>
            <span class="year-link">해당 문서 보기 →</span>
          </button>
        ))}</div>
      ))}</div>
      </div>
    </details>

    <section class="panel keyword-evidence-panel" aria-label="키워드별 4개 기준 근거 현황">
      <div class="panel-heading"><div><small>KEYWORD EVIDENCE REVIEW</small><h2>키워드별 4개 기준 근거 현황</h2></div><p class="caution">키워드를 선택하고 버튼을 눌러 확인하세요. 제목·요약과 추출 수치 기반의 근거 현황이며, 기술의 우열·실제 적용·상용화 가능성을 판정한 결과는 아닙니다.</p></div>
      <div class="evidence-controls"><label>키워드<select id="evidence-keyword" disabled={!topKeywords.length}>{topKeywords.map(([keyword, count]) => <option value={keyword.toLowerCase()}>{keyword} · {count}건</option>)}</select></label><button type="button" id="show-keyword-evidence" aria-expanded="false" aria-controls="keyword-evidence-results" disabled={!topKeywords.length}>4개 기준 근거 현황 보기</button></div>
      {!topKeywords.length && <p class="company-help">분석할 키워드가 없습니다.</p>}
      <div id="keyword-evidence-results" hidden>
        <div class="evidence-result-toolbar"><span>동일 자료가 여러 기준에 포함될 수 있습니다.</span><button type="button" id="close-keyword-evidence">닫기</button></div>
        {keywordEvidence.map((review) => <div data-keyword-evidence={review.keyword.toLowerCase()} hidden>
          <div class="evidence-result-heading"><h3 tabindex="-1">{review.keyword} · 관련 자료 {review.total}건</h3><button type="button" data-keyword-filter={review.keyword.toLowerCase()}>관련 자료 보기</button></div>
          <div class="evidence-criteria">{review.criteria.map((criterion, index) => <article class="evidence-criterion">
            <div class="evidence-criterion-heading"><h4>{index + 1}. {criterion.title}</h4><span>{criterion.status}</span></div>
            <p>{criterion.description}</p>
            <dl>{criterion.groups.map((group) => <div><dt>{group.label}</dt><dd>{group.count}건</dd></div>)}</dl>
            {criterion.sources.length ? <details><summary>{index === 2 ? "분류 자료" : "근거 자료"} {criterion.sources.length}건 보기</summary><ul class="evidence-source-list" tabindex="0" aria-label={`${criterion.title} 근거 자료`}>{criterion.sources.map((entry) => <li><a href={entry.url} target="_blank" rel="noreferrer">{entry.title} ↗</a><small>{entry.source} · {entry.date || "날짜 확인 필요"}</small><p>{entry.evidence}</p></li>)}</ul></details> : <p class="evidence-unconfirmed">제목·요약에서 근거를 확인하지 못했습니다. 원문 확인이 필요합니다.</p>}
          </article>)}</div>
        </div>)}
      </div>
    </section>

    <details class="panel matrix-panel section-disclosure">
      <summary class="section-summary"><div class="section-title"><small>COMPANY KEYWORDS</small><h2>기업별 기술 경쟁</h2></div><span class="section-toggle"><span class="when-closed">보기</span><span class="when-open">접기</span></span></summary>
      <div class="section-content">
      <p class="company-help">각 기업이 언급된 자료에서 키워드별 자료 수가 많은 순서로 표시합니다. 기업명이나 키워드를 누르면 해당 문서만 볼 수 있습니다.</p>
      {companyMatrix.length ? <div class="company-rows">{companyMatrix.map((row) => (
        <article class="company-row">
          <div class="company-heading"><button type="button" class="company-filter" data-company-filter={row.company} aria-pressed="false" aria-label={`${row.company} 관련 문서 ${row.total}건 보기`}>{row.company}<span aria-hidden="true"> →</span></button><span>관련 자료 {row.total}건</span></div>
          {row.keywords.length ? <ol class="company-keywords">{row.keywords.map(([keyword, count], index) => (
            <li><button type="button" data-keyword-company={row.company} data-company-keyword={keyword.toLowerCase()} aria-label={`${row.company} ${keyword} 문서 ${count}건 보기`}><span class="company-keyword-rank">{index + 1}</span><span>{keyword}</span><strong>{count}건</strong></button></li>
          ))}</ol> : <p class="company-help">확인된 키워드가 없습니다.</p>}
        </article>
      ))}</div> : <div class="empty">기업명이 확인된 문서가 아직 없습니다.</div>}
      </div>
    </details>

    <details class="panel performance-panel section-disclosure">
      <summary class="section-summary"><div class="section-title"><small>PERFORMANCE EVIDENCE</small><h2>제목·요약에서 확인된 성능 수치</h2></div><span class="section-toggle"><span class="when-closed">보기</span><span class="when-open">접기</span></span></summary>
      <div class="section-content">
      <p class="caution">제목·요약에서 지표와 단위가 명확히 연결된 수치만 표시합니다. 대상과 조건은 문맥 기준이며, 요약에서 확인되지 않는 조건은 원문 확인이 필요합니다. 수율·변화율·배터리 사용시간은 제외합니다.</p>
      {performanceMetrics.length ? <div class="metric-grid">{performanceMetrics.map(({ item, ...metric }) => (
        <article class="metric-card">
          <div class="metric-main"><div class="metric-heading"><span>{metricLabels[metric.name]}</span>{metric.qualifier && <small>{metric.qualifier}</small>}</div><strong class="metric-value">{metric.value.toLocaleString()} {metric.unit}</strong></div>
          <dl><div><dt>대상</dt><dd>{metric.target || "측정 대상 미공개"}</dd></div><div><dt>조건</dt><dd>{metric.conditions?.length ? metric.conditions.join(" · ") : "원문 확인 필요"}</dd></div></dl>
          <details class="metric-detail"><summary>상세 보기</summary><p class="metric-evidence">{metric.context}</p><a class="metric-title" href={item.url} target="_blank" rel="noreferrer">{item.title} ↗</a></details>
          <a class="metric-source" href={item.url} target="_blank" rel="noreferrer"><span>{item.source} ↗</span><small>{item.published_at}</small></a>
        </article>
      ))}</div> : <div class="empty">성능 단위가 명시된 문서를 수집하면 표시됩니다.</div>}
      </div>
    </details>

    <section class="decision-section">
      <div class="section-heading"><small>CONDITIONAL DECISION</small><h2>상용화 관련 주요 기술 동향</h2><p>수집 자료의 기술 언급 비중을 바탕으로 정리한 검토 방향입니다.</p></div>
      <div class="decision-grid">{decisionAreas.map((area) => (
        <article><div class="decision-top"><span>{area.code}</span><b>{area.score}</b></div><h3>{area.title}</h3><p>{area.action}</p><small>관련 근거 {area.evidence}건</small><div class="score"><i style={`width:${area.score}%`}></i></div></article>
      ))}</div>
    </section>

    <section class="panel documents">
      <div class="panel-heading list-heading">
        <div><small>EVIDENCE FEED</small><h2>기술 뉴스·논문 모아보기</h2></div>
        <div class="controls">
          <div class="type-filter region-filter" role="group" aria-label="자료 유형 필터">
            <button class="active" type="button" data-document-type="all" aria-pressed="true">전체 <span>{documents.length}</span></button>
            <button type="button" data-document-type="paper" aria-pressed="false">논문 <span>{documents.filter((item) => item.source_type === "paper").length}</span></button>
            <button type="button" data-document-type="news" aria-pressed="false">뉴스 <span>{documents.filter((item) => item.source_type === "news").length}</span></button>
          </div>
          <div class="region-filter" role="group" aria-label="지역 필터">
            <button class="active" type="button" data-region="all">전체 <span>{documents.length}</span></button>
            <button type="button" data-region="domestic">국내 <span>{domesticCount}</span></button>
            <button type="button" data-region="international">해외 <span>{internationalCount}</span></button>
          </div>
          <label class="year-select">연도
            <select id="document-year" aria-label="문서 연도 필터">
              <option value="all">전체 연도</option>
              {documentYears.map((year) => <option value={year}>{year}년 · {documentYearCounts[year]}건</option>)}
            </select>
          </label>
          <label class="year-select">정렬
            <select id="document-sort" aria-label="문서 날짜 정렬">
              <option value="newest">최신순</option>
              <option value="oldest">오래된순</option>
            </select>
          </label>
          <label class="year-select">태그
            <select id="document-tag" aria-label="문서 기술 태그 필터">
              <option value="">전체 태그</option>
              {documentTags.map((tag) => <option value={tag}>{tag}</option>)}
            </select>
          </label>
          <input id="document-filter" type="search" placeholder="제목·기술 검색" aria-label="문서 검색" />
        </div>
      </div>
      <p class="document-scroll-help">문서는 한 번에 최대 8개씩 표시됩니다. 목록 안에서 스크롤해 더 확인하세요.</p>
      <div class="document-filter-status"><p id="document-filter-status" role="status" aria-live="polite"></p><button type="button" id="reset-document-filters">검색 조건 초기화</button></div>
      <div id="document-empty" class="empty" hidden>선택한 조건에 해당하는 문서가 없습니다.</div>
      <div id="document-list" tabindex="0" role="region" aria-label="기술 뉴스·논문 목록">
        {documents.length ? documents.map((item) => (
          <article class="document" data-tags={JSON.stringify(item.technologies)} data-companies={JSON.stringify(item.company || [])} data-keywords={JSON.stringify((item.keywords || []).map((keyword) => keyword.toLowerCase()))} data-custom-keyword={(item.custom_keyword || "").toLowerCase()} data-document-kind={item.source_type} data-published-at={item.published_at} data-region={item.region} data-year={item.published_at.slice(0, 4)} data-search={`${item.title} ${item.technologies.join(" ")} ${(item.keywords || []).join(" ")} ${(item.company || []).join(" ")} ${item.custom_keyword || ""}`.toLowerCase()}>
            <div class="doc-meta"><span>{item.source} · {item.region === "domestic" ? "국내" : "해외"}</span><time>{item.published_at || "날짜 미상"}</time></div>
            <h3><a href={item.url} target="_blank" rel="noreferrer">{item.title}</a></h3>
            <p>{item.summary}</p>
            <div class="tags">{item.technologies.map((tag) => <button type="button" data-document-tag={tag} aria-pressed="false">{tag}</button>)}</div>
          </article>
        )) : <div class="empty large"><strong>아직 수집된 문서가 없습니다.</strong><code>python scripts/collect.py</code>를 실행하세요.</div>}
      </div>
    </section>
    <section class="sources-section">
      <article class="panel sources">
        <div class="panel-heading"><div><small>SOURCES</small><h2>출처 현황</h2></div><p class="caution">한 출처에서 여러 자료가 수집될 수 있습니다. 숫자는 각 출처에서 수집된 자료 수입니다.</p></div>
        {Object.keys(sourceCounts).length ? <div class="source-list">{Object.entries(sourceCounts).sort(([leftSource, leftCount], [rightSource, rightCount]) => rightCount - leftCount || leftSource.localeCompare(rightSource, "ko")).map(([source, count]) => (
          <div class="source-row"><span>{source}</span><strong>{count}</strong></div>
        ))}</div> : <div class="empty">수집기를 실행하면 Crossref·arXiv 자료가 추가됩니다.</div>}
      </article>
    </section>
  </main>

  <script>
    const nextUpdateElement = document.querySelector<HTMLTimeElement>("#next-update");
    if (nextUpdateElement) {
      const now = new Date();
      const next = new Date(now);
      next.setUTCHours(0, 10, 0, 0);
      if (next <= now) next.setUTCDate(next.getUTCDate() + 1);
      nextUpdateElement.dateTime = next.toISOString();
      nextUpdateElement.textContent = new Intl.DateTimeFormat("ko-KR", {
        timeZone: "Asia/Seoul", year: "numeric", month: "2-digit", day: "2-digit",
        hour: "2-digit", minute: "2-digit", hour12: false,
      }).format(next);
    }
    const evidenceSelect = document.querySelector<HTMLSelectElement>("#evidence-keyword");
    const evidenceButton = document.querySelector<HTMLButtonElement>("#show-keyword-evidence");
    const evidenceResults = document.querySelector<HTMLElement>("#keyword-evidence-results");
    const hideEvidence = () => {
      if (evidenceResults) evidenceResults.hidden = true;
      evidenceButton?.setAttribute("aria-expanded", "false");
    };
    evidenceSelect?.addEventListener("change", hideEvidence);
    evidenceButton?.addEventListener("click", () => {
      if (!evidenceResults) return;
      const keyword = evidenceSelect?.value || "";
      evidenceResults.querySelectorAll<HTMLElement>("[data-keyword-evidence]").forEach((panel) => { panel.hidden = panel.dataset.keywordEvidence !== keyword; });
      evidenceResults.hidden = false;
      evidenceButton.setAttribute("aria-expanded", "true");
      evidenceResults.querySelector<HTMLElement>("[data-keyword-evidence]:not([hidden]) h3")?.focus({ preventScroll: true });
    });
    document.querySelector("#close-keyword-evidence")?.addEventListener("click", () => { hideEvidence(); evidenceButton?.focus(); });
    const input = document.querySelector<HTMLInputElement>("#document-filter");
    const yearSelect = document.querySelector<HTMLSelectElement>("#document-year");
    const sortSelect = document.querySelector<HTMLSelectElement>("#document-sort");
    const tagSelect = document.querySelector<HTMLSelectElement>("#document-tag");
    let selectedTag = "";
    const regionButtons = document.querySelectorAll<HTMLButtonElement>(".region-filter [data-region]");
    const typeButtons = document.querySelectorAll<HTMLButtonElement>("[data-document-type]");
    let selectedType = "all";
    let selectedRegion = "all";
    let selectedYear = "all";
    let selectedTrendKeyword = "";
    let selectedCompany = "";
    const documentList = document.querySelector<HTMLElement>("#document-list");
    const resizeDocumentList = () => {
      if (!documentList) return;
      const visible = [...documentList.querySelectorAll<HTMLElement>(".document")].filter((item) => !item.hidden);
      const eighth = visible[7];
      if (!eighth) {
        documentList.style.maxHeight = "none";
        return;
      }
      const height = eighth.getBoundingClientRect().bottom - documentList.getBoundingClientRect().top + documentList.scrollTop;
      documentList.style.maxHeight = `${height}px`;
    };
    window.addEventListener("resize", resizeDocumentList);
    document.fonts.ready.then(resizeDocumentList);
    resizeDocumentList();
    const sortDocuments = () => {
      if (!documentList) return;
      const direction = sortSelect?.value === "oldest" ? 1 : -1;
      const cards = [...documentList.querySelectorAll<HTMLElement>(".document")];
      cards.sort((left, right) => {
        const leftDate = left.dataset.publishedAt || "";
        const rightDate = right.dataset.publishedAt || "";
        const leftKnown = /^\d{4}/.test(leftDate);
        const rightKnown = /^\d{4}/.test(rightDate);
        if (leftKnown !== rightKnown) return leftKnown ? -1 : 1;
        return direction * leftDate.localeCompare(rightDate);
      });
      documentList.append(...cards);
    };
    const applyFilters = () => {
      sortDocuments();
      const query = input?.value.trim().toLowerCase() || "";
      const regionCounts: Record<string, number> = { all: 0, domestic: 0, international: 0 };
      document.querySelectorAll<HTMLElement>(".document").forEach((documentElement) => {
        const matchesText = selectedTrendKeyword
          ? (JSON.parse(documentElement.dataset.keywords || "[]") as string[]).includes(selectedTrendKeyword)
          : (documentElement.dataset.search || "").includes(query);
        const matchesRegion = selectedRegion === "all" || documentElement.dataset.region === selectedRegion;
        const matchesYear = selectedYear === "all" || documentElement.dataset.year === selectedYear;
        const matchesCompany = !selectedCompany || (JSON.parse(documentElement.dataset.companies || "[]") as string[]).includes(selectedCompany);
        const matchesType = selectedType === "all" || documentElement.dataset.documentKind === selectedType;
        const matchesTag = !selectedTag || (JSON.parse(documentElement.dataset.tags || "[]") as string[]).includes(selectedTag);
        if (matchesText && matchesYear && matchesCompany && matchesType && matchesTag) {
          regionCounts.all += 1;
          const region = documentElement.dataset.region || "";
          if (region === "domestic" || region === "international") regionCounts[region] += 1;
        }
        documentElement.hidden = !(matchesText && matchesRegion && matchesYear && matchesCompany && matchesType && matchesTag);
      });
      regionButtons.forEach((button) => {
        const region = button.dataset.region || "all";
        const countElement = button.querySelector("span");
        if (countElement) countElement.textContent = String(regionCounts[region] || 0);
        button.classList.toggle("active", region === selectedRegion);
        button.setAttribute("aria-pressed", String(region === selectedRegion));
      });
      typeButtons.forEach((button) => {
        const active = button.dataset.documentType === selectedType;
        button.classList.toggle("active", active);
        button.setAttribute("aria-pressed", String(active));
      });
      const count = document.querySelectorAll(".document:not([hidden])").length;
      const status = document.querySelector<HTMLElement>("#document-filter-status");
      if (status) status.textContent = `${selectedType === "all" ? "전체 자료" : selectedType === "paper" ? "논문" : "뉴스"} · ${selectedYear === "all" ? "전체 연도" : selectedYear + "년"} · ${[selectedCompany, selectedTrendKeyword || query, selectedTag].filter(Boolean).join(" · ") || "전체 키워드"} · ${count}건`;
      document.querySelectorAll<HTMLButtonElement>("[data-document-tag]").forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.documentTag === selectedTag)));
      document.querySelectorAll<HTMLButtonElement>("[data-company-filter]").forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.companyFilter === selectedCompany)));
      const empty = document.querySelector<HTMLElement>("#document-empty");
      if (empty) empty.hidden = count > 0;
      if (documentList) documentList.scrollTop = 0;
      resizeDocumentList();
    };
    input?.addEventListener("input", () => { selectedCompany = ""; selectedTrendKeyword = ""; applyFilters(); });
    typeButtons.forEach((button) => button.addEventListener("click", () => {
      selectedType = button.dataset.documentType || "all";
      applyFilters();
    }));
    sortSelect?.addEventListener("change", applyFilters);
    tagSelect?.addEventListener("change", () => {
      selectedTag = tagSelect.value;
      applyFilters();
    });
    document.querySelectorAll<HTMLButtonElement>("[data-document-tag]").forEach((button) => button.addEventListener("click", () => {
      selectedTag = selectedTag === button.dataset.documentTag ? "" : button.dataset.documentTag || "";
      if (tagSelect) tagSelect.value = selectedTag;
      applyFilters();
    }));
    yearSelect?.addEventListener("change", () => {
      selectedYear = yearSelect.value;
      applyFilters();
    });
    const trendKeywordSelect = document.querySelector<HTMLSelectElement>("#trend-keyword");
    const trendYearSelect = document.querySelector<HTMLSelectElement>("#trend-year");
    const applyTrendFilters = () => {
      const keyword = trendKeywordSelect?.value || "";
      const year = trendYearSelect?.value || "all";
      document.querySelectorAll<HTMLElement>("[data-trend-keyword]").forEach((trend) => {
        trend.hidden = trend.dataset.trendKeyword !== keyword;
        trend.querySelectorAll<HTMLElement>("[data-trend-year]").forEach((entry) => {
          entry.hidden = year !== "all" && entry.dataset.trendYear !== year;
        });
      });
    };
    trendKeywordSelect?.addEventListener("change", applyTrendFilters);
    trendYearSelect?.addEventListener("change", applyTrendFilters);
    document.querySelectorAll<HTMLButtonElement>("[data-trend-filter]").forEach((button) => button.addEventListener("click", () => {
      selectedCompany = "";
      selectedTrendKeyword = button.dataset.trendFilter || "";

      selectedYear = button.dataset.trendYear || "all";
      selectedType = selectedRegion = "all";
      if (input) input.value = selectedTrendKeyword;
      if (yearSelect) {
        if (![...yearSelect.options].some((option) => option.value === selectedYear)) yearSelect.add(new Option(`${selectedYear}년`, selectedYear));
        yearSelect.value = selectedYear;
      }
      regionButtons.forEach((candidate) => candidate.classList.toggle("active", candidate.dataset.region === "all"));
      applyFilters();
      document.querySelector(".documents")?.scrollIntoView({ behavior: "smooth" });
    }));
    document.querySelector("#reset-document-filters")?.addEventListener("click", () => {
      selectedCompany = selectedTrendKeyword = "";
      selectedTag = "";
      if (tagSelect) tagSelect.value = "";
      selectedType = selectedYear = selectedRegion = "all";
      if (input) input.value = "";
      if (yearSelect) yearSelect.value = "all";
      regionButtons.forEach((candidate) => candidate.classList.toggle("active", candidate.dataset.region === "all"));
      applyFilters();
    });
    document.querySelectorAll<HTMLButtonElement>("[data-company-filter]").forEach((button) => button.addEventListener("click", () => {
      selectedCompany = button.dataset.companyFilter || "";
      selectedTrendKeyword = "";
      selectedType = selectedYear = selectedRegion = "all";
      if (input) input.value = "";
      if (yearSelect) yearSelect.value = "all";
      regionButtons.forEach((candidate) => candidate.classList.toggle("active", candidate.dataset.region === "all"));
      applyFilters();
      document.querySelector(".documents")?.scrollIntoView({ behavior: "smooth" });
    }));
    document.querySelectorAll<HTMLButtonElement>("[data-company-keyword]").forEach((button) => button.addEventListener("click", () => {
      selectedCompany = button.dataset.keywordCompany || "";
      selectedTrendKeyword = button.dataset.companyKeyword || "";
      selectedType = selectedYear = selectedRegion = "all";
      if (input) input.value = selectedTrendKeyword;
      if (yearSelect) yearSelect.value = "all";
      regionButtons.forEach((candidate) => candidate.classList.toggle("active", candidate.dataset.region === "all"));
      applyFilters();
      document.querySelector(".documents")?.scrollIntoView({ behavior: "smooth" });
    }));
    applyFilters();
    regionButtons.forEach((button) => button.addEventListener("click", () => {
      selectedRegion = button.dataset.region || "all";
      regionButtons.forEach((candidate) => candidate.classList.toggle("active", candidate === button));
      applyFilters();
    }));

    document.querySelectorAll<HTMLButtonElement>("[data-keyword-filter]").forEach((button) => button.addEventListener("click", () => {
      selectedCompany = "";
      selectedTrendKeyword = button.dataset.keywordFilter || "";

      if (input) input.value = button.dataset.keywordFilter || "";
      selectedYear = "all";
      if (yearSelect) yearSelect.value = "all";
      selectedType = selectedRegion = "all";
      regionButtons.forEach((candidate) => candidate.classList.toggle("active", candidate.dataset.region === "all"));
      applyFilters();
      document.querySelector(".documents")?.scrollIntoView({ behavior: "smooth" });
    }));

    const collectionForm = document.querySelector<HTMLFormElement>("#collection-form");
    const resultBox = document.querySelector<HTMLElement>("#collection-result");
    const statusElement = document.querySelector<HTMLElement>("#collection-status");
    const downloadLink = document.querySelector<HTMLAnchorElement>("#download-report");
    const serverUnavailableMessage = "현재 수집 서버를 이용할 수 없습니다. Render 무료 사용량 소진, 서버 절전 또는 일시 장애가 원인일 수 있습니다. 잠시 후 다시 시도하고, 계속되면 운영자에게 문의해 주세요. 무료 사용량이 소진된 경우 한도 갱신 전까지 이용이 제한될 수 있습니다.";
    const collectButton = collectionForm?.querySelector<HTMLButtonElement>("button[type=submit]");
    collectionForm?.addEventListener("input", () => document.querySelector<HTMLInputElement>("#collect-to")?.setCustomValidity(""));
    collectionForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const keyword = document.querySelector<HTMLInputElement>("#collect-keyword")?.value.trim();
      const dateFrom = document.querySelector<HTMLInputElement>("#collect-from")?.value;
      const dateTo = document.querySelector<HTMLInputElement>("#collect-to")?.value;
      const source = document.querySelector<HTMLSelectElement>("#collect-source")?.value || "all";
      if (!keyword) return;
      const endInput = document.querySelector<HTMLInputElement>("#collect-to");
      if (endInput) {
        endInput.setCustomValidity(dateFrom && dateTo && dateFrom > dateTo ? "종료일은 시작일 이후로 선택해 주세요." : "");
        if (!endInput.reportValidity()) return;
      }
      if (resultBox) resultBox.hidden = false;
      if (downloadLink) { downloadLink.hidden = true; downloadLink.removeAttribute("href"); }
      const setStatus = (message: string) => { if (statusElement) statusElement.textContent = message; };
      const api = (collectionForm?.dataset.reportApi || "").replace(/\/$/, "");
      if (!api) {
        setStatus("보고서 서비스를 준비 중입니다. 연결이 완료되면 이 화면에서 수집과 다운로드를 이용할 수 있습니다.");
        return;
      }
      if (collectButton) collectButton.disabled = true;
      setStatus("수집 서버에 연결하고 있습니다. 무료 서버의 첫 연결은 1분 이상 걸릴 수 있습니다.");
      try {
        const response = await fetch(`${api}/reports`, {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ keyword, date_from: dateFrom || null, date_to: dateTo || null, source }),
          signal: AbortSignal.timeout(120000),
        });
        if (!response.ok) {
          const error = await response.json().catch(() => ({}));
          const fallback = response.status >= 500 || response.status === 402 || response.status === 403
            ? serverUnavailableMessage
            : "수집 요청을 처리하지 못했습니다. 입력 조건을 확인한 뒤 다시 시도해 주세요.";
          throw new Error(typeof error.detail === "string" ? error.detail : fallback);
        }
        const { id } = await response.json();
        if (typeof id !== "string" || !/^[a-f0-9-]{36}$/i.test(id)) throw new Error("수집 요청을 확인하지 못했습니다.");
        for (let attempt = 0; attempt < 400; attempt++) {
          const result = await fetch(`${api}/reports/${id}`, { cache: "no-store", signal: AbortSignal.timeout(30000) });
          if (!result.ok) throw new Error(result.status >= 500 || result.status === 402 || result.status === 403
            ? serverUnavailableMessage
            : "수집 상태를 확인하지 못했습니다. 서버가 재시작되었을 수 있으니 잠시 후 다시 시도해 주세요.");
          const job = await result.json();
          setStatus(job.message || "수집 중입니다.");
          if (job.state === "completed" || job.state === "failed") {
            if (job.downloadable && downloadLink) {
              downloadLink.href = `${api}/reports/${id}/download`;
              downloadLink.download = "oled-custom-report.html";
              downloadLink.hidden = false;
            }
            return;
          }
          await new Promise((resolve) => setTimeout(resolve, 3000));
        }
        throw new Error("수집 대기 시간이 길어지고 있습니다. 잠시 후 다시 시도해 주세요.");
      } catch (error) {
        setStatus(error instanceof Error && error.name === "Error" ? error.message : serverUnavailableMessage);
      } finally {
        if (collectButton) collectButton.disabled = false;
      }
    });
  </script>
</Layout>

<style>
  main { width: min(1180px, calc(100% - 32px)); margin: 0 auto; padding: 64px 0 96px; }
  .hero { padding: 44px 0 54px; border-bottom: 1px solid var(--border); }
  .eyebrow { color: var(--text-muted); font-size: .72rem; font-weight: 800; letter-spacing: .18em; display: flex; align-items: center; gap: 10px; }
  .eyebrow span { width: 30px; height: 2px; background: var(--brand); }
  h1 { margin: 22px 0 18px; font-size: clamp(2rem, 4.6vw, 4rem); line-height: 1.25; letter-spacing: -.05em; max-width: 1100px; word-break: keep-all; }
  h1 em { color: var(--brand); font-style: normal; }
  .hero p { max-width: 680px; color: var(--text-secondary); font-size: clamp(1rem, 2vw, 1.2rem); line-height: 1.75; }
  .hero .hero-subtitle { max-width: none; color: var(--text); font-size: clamp(1.1rem, 2.4vw, 1.5rem); font-weight: 700; }
  .meta { display: grid; gap: 8px; color: var(--text-muted); font-size: .78rem; margin-top: 28px; line-height: 1.6; }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; margin: 28px 0; background: var(--border); border: 1px solid var(--border); }
  .stats article { background: var(--surface); padding: 25px; display: flex; flex-direction: column; gap: 6px; }
  .stats b { font-size: 2rem; color: var(--brand); }
  .stats span { color: var(--text-muted); font-size: .82rem; }
  .sources-section { margin-top: 20px; }
  .keyword-tools { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(320px, .75fr); gap: 20px; margin-bottom: 20px; }
  .quality-strip { display: grid; grid-template-columns: repeat(6, 1fr); gap: 1px; margin: 0 0 20px; border: 1px solid var(--border); background: var(--border); }
  .quality-strip div { background: var(--surface); padding: 16px; display: flex; flex-direction: column; gap: 5px; }
  .quality-strip span { color: var(--text-muted); font-size: .72rem; }
  .quality-strip strong { color: var(--text); font-size: 1.2rem; }
  .keyword-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7px 20px; }
  .keyword-list button { display: grid; grid-template-columns: 28px minmax(95px, auto) 1fr 48px; align-items: center; gap: 10px; border: 0; border-bottom: 1px solid var(--border); background: transparent; color: var(--text-secondary); padding: 9px 0; text-align: left; cursor: pointer; }
  .keyword-list button:hover .keyword-name { color: var(--brand); }
  .rank { color: var(--text-muted); font-size: .66rem; }
  .keyword-name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: .76rem; }
  .keyword-list i { height: 3px; background: var(--border); }
  .keyword-list i b { display: block; height: 100%; background: var(--brand); }
  .keyword-list strong { color: var(--text); text-align: right; }
  .custom-collector form { display: grid; gap: 13px; }
  .custom-collector label { color: var(--text-muted); font-size: .72rem; display: grid; gap: 6px; }
  .custom-collector input, .custom-collector select { width: 100%; background: var(--surface); color: var(--text); border: 1px solid var(--border-strong); padding: 10px 12px; }
  .date-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .command-button, #download-report { border: 0; background: var(--brand); color: var(--on-brand); font-weight: 800; padding: 11px; cursor: pointer; text-decoration: none; display: inline-block; text-align: center; }
  .command-button:hover, #download-report:hover { background: var(--brand-hover); }
  #collection-result { margin-top: 14px; border: 1px solid var(--border-strong); padding: 12px; }
  #collection-result code { display: block; color: var(--text-secondary); font-size: .68rem; word-break: break-all; line-height: 1.6; margin-bottom: 10px; }
  #download-report { padding: 8px 10px; font-size: .72rem; }
  .collector-help { color: var(--text-muted); font-size: calc(.68rem - 2px); line-height: 1.9; margin: 15px 0 0; }
  .panel { min-width: 0; background: var(--surface); border: 1px solid var(--border); border-radius: 3px; padding: 26px; }
  .panel-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 22px; }
  .panel-heading > div { min-width: 0; }
  .section-disclosure { margin-bottom: 20px; }
  .section-summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; cursor: pointer; list-style: none; }
  .section-summary::-webkit-details-marker { display: none; }
  .section-summary:focus-visible { outline: 2px solid var(--brand); outline-offset: 6px; }
  .section-title { min-width: 0; }
